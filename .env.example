# ===========================================================================
# DENSO Sense — environment variables (TEMPLATE)
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` (gitignored) for local dev and fill the values.
# On Azure Static Web Apps, set these in the portal:
#   - SERVER / SECRET vars  -> SWA "Configuration" > "Application settings"
#   - NEXT_PUBLIC_* vars    -> must be present at BUILD time in GitHub Actions
#                              (Next.js inlines them into the client bundle).
#                              See .github/workflows/azure-static-web-apps.yml.
# Anything left blank degrades gracefully (see notes per section).
# ===========================================================================

# ---------------------------------------------------------------------------
# 1) Google reCAPTCHA v2 ("I'm not a robot" checkbox)
# Create a v2 key pair at https://www.google.com/recaptcha/admin
# (add the production domain + localhost).
#
# Behaviour:
#   - Both keys set      -> real checkbox + server-side verification (production).
#   - Neither key set    -> checkbox is skipped and the lead form still works
#                           (development bypass). Lights up automatically once
#                           the keys are present.
# ---------------------------------------------------------------------------

# Public — sent to the browser (must keep the NEXT_PUBLIC_ prefix). BUILD-TIME.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Secret — server-only, used to verify tokens. Never expose to the client. RUNTIME.
RECAPTCHA_SECRET_KEY=

# ---------------------------------------------------------------------------
# 2) Lead persistence — Book-a-Demo form (app/api/lead/route.ts)
# The route is currently a stub (validates + logs). Wire ONE of the below in
# production. Recommended: Azure Cosmos DB (serverless) OR Azure Table Storage,
# Central India region (lead PII data residency). RUNTIME secrets.
# ---------------------------------------------------------------------------

# Option A — Azure Cosmos DB (serverless). From Key Vault / SWA app settings.
COSMOS_CONNECTION_STRING=
COSMOS_DATABASE=denso-sense
COSMOS_LEADS_CONTAINER=leads

# Option B — Azure Table Storage (cheaper, simpler). Use instead of Cosmos.
# AZURE_STORAGE_CONNECTION_STRING=
# LEADS_TABLE_NAME=leads

# ---------------------------------------------------------------------------
# 3) Lead notification email — Azure Communication Services (Email)
# Notifies the sales inbox (and optionally the applicant) on each submission.
# RUNTIME secrets.
# ---------------------------------------------------------------------------
ACS_CONNECTION_STRING=
LEAD_FROM_EMAIL=DoNotReply@your-verified-acs-domain.azurecomm.net
SALES_INBOX_EMAIL=sales@denso-sense.example

# ---------------------------------------------------------------------------
# 4) Media base URL — Use Cases videos (components/UseCases.tsx)
# The 6 clips are referenced as /videos/use-case-1.mp4 … use-case-6.mp4.
#   - BLANK  -> served from /public/videos in the app itself (local dev, or
#               bundled into the deploy if the files are committed).
#   - SET    -> served from <base>/videos/use-case-N.mp4 — point this at an
#               Azure Blob container behind Front Door (CDN) for production so
#               the ~189 MB of video stays OUT of the repo & the SWA bundle.
# Example: https://densosense.blob.core.windows.net/media
# BUILD-TIME (NEXT_PUBLIC_ is inlined at build — set it as a GitHub secret).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_MEDIA_BASE_URL=
